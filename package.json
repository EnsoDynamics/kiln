{
  "name": "@ensodynamics/kiln",
  "version": "1.0.0",
  "description": "Runs an Enso Method phase plan end to end: one unattended Claude Code session per phase, checked in Git, with a local browser view.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kiln": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "prompts/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnsoDynamics/kiln.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config view/vite.config.ts --logLevel warn",
    "prepack": "npm run build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig view/tsconfig.json --threshold warning",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.mts",
    "test:package": "vitest run --config vitest.package.config.mts",
    "audit": "node scripts/audit-dependencies.mjs",
    "verify": "npm run audit && npm run lint && npm run typecheck && npm test && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22",
    "eslint": "^9",
    "markdown-it": "^15.0.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8.3.4",
    "vitest": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  }
}
