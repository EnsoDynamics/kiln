{
  "name": "@ensodynamics/kiln",
  "version": "1.1.1",
  "description": "Runs an Enso Method phase plan with Claude Code or Codex, Git completion checks and a local browser view.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "coding-agents",
    "enso-method",
    "prd",
    "automation",
    "cli"
  ],
  "homepage": "https://ensomethod.org/kiln/",
  "bugs": {
    "url": "https://github.com/EnsoDynamics/kiln/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Enso Dynamics",
    "email": "doug@ensodynamics.com"
  },
  "type": "module",
  "bin": {
    "kiln": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "prompts/"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnsoDynamics/kiln.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-build-output.mjs && tsc -p tsconfig.build.json && vite build --config view/vite.config.ts --logLevel warn && node scripts/write-build-info.mjs",
    "prepack": "npm run build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig view/tsconfig.json --threshold warning",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.mts",
    "test:package": "vitest run --config vitest.package.config.mts",
    "audit": "node scripts/audit-dependencies.mjs",
    "verify": "npm run audit && npm run lint && npm run typecheck && npm test && npm run test:release && npm run test:codex-proof && npm run test:integration",
    "test:codex-proof": "npm run build && node --test scripts/proof-run/codex-proof.test.mjs",
    "test:live-proof": "npm run build && node --test scripts/proof-run/live-control-proof.test.mjs",
    "hooks:install": "node scripts/release.mjs install-hooks",
    "release:prepare": "node scripts/release.mjs prepare",
    "test:release": "node --test scripts/release.test.mjs",
    "verify:development": "npm run audit && npm run lint && npm run typecheck && npm test && npm run test:release && npm run test:codex-proof"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.311",
    "@eslint/js": "^10.0.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22",
    "ajv": "6.15.0",
    "eslint": "^10.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@hono/node-server": "^2.1.5",
    "acorn": "^8.19.0",
    "hono": "^4.13.14",
    "markdown-it": "^15.0.3"
  }
}
