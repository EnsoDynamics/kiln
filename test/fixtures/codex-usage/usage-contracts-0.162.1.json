                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "httpConnectionFailed": {
                    "properties": {
                      "httpStatusCode": {
                        "format": "uint16",
                        "minimum": 0.0,
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "httpConnectionFailed"
