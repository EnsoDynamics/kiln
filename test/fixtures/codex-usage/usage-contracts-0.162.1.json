        "definitions": {
          "CodexErrorInfo": {
            "anyOf": [
              {
                "enum": [
                  "contextWindowExceeded",
                  "sessionBudgetExceeded",
                  "usageLimitExceeded",
                  "rateLimitExceeded",
                  "flexUnavailable",
                  "serverOverloaded",
                  "cyberPolicy",
                  "misalignmentPolicyViolation",
                  "tooManyDenials",
