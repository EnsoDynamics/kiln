              "errorType": {
                "description": "Open-ended classification; clients must accept categories added by Responses.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewTarget": {
                "description": "Opaque server-issued block target. Presence alone does not enable target-based continuation.",
